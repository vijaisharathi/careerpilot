{
  "name": "career-pilot-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API service for Career Pilot AI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
