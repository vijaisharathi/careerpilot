# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration
# Local MongoDB: mongodb://localhost:27017/career_pilot_ai
MONGODB_URI=mongodb://localhost:27017/career_pilot_ai

# JWT Authentication
# Access token (short-lived, e.g. 15m)
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_EXPIRES_IN=15m

# Refresh token (long-lived with rotation, e.g. 7d)
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider Configuration ("mock", "gemini", "openai")
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Logging
LOG_LEVEL=info
